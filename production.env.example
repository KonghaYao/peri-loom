# Copy to deploy/production.env; never commit it or print expanded Compose config.
# Use an image digest verified and approved for your deployment (not the preview release tag).
PERI_IMAGE=ghcr.io/owner/peri-loom@sha256:REPLACE_WITH_REVIEWED_DIGEST
PERI_BIND_IP=127.0.0.1
PERI_GATEWAY_PORT=9443
# Existing dedicated S3-compatible bucket; endpoint must be reachable from the container.
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=REPLACE_WITH_DEDICATED_BUCKET
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_KEY
# Leave blank unless using temporary session credentials.
S3_SESSION_TOKEN=
