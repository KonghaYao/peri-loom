diff --git a/prototypes/v1/platform/perf_probe_r54.go b/prototypes/v1/platform/perf_probe_r54.go
new file mode 100644
index 0000000..a1af64d
--- /dev/null
+++ b/prototypes/v1/platform/perf_probe_r54.go
@@ -0,0 +1,39 @@
+package platform
+
+import (
+	"fmt"
+	"os"
+	"sync/atomic"
+	"time"
+)
+
+// Temporary R54 upper-bound probe. Not for merge.
+
+var (
+	r54Pages       atomic.Int64
+	r54ReadallNS   atomic.Int64
+	r54SpansNS     atomic.Int64
+	r54SkeletonNS  atomic.Int64
+	r54ScanNS      atomic.Int64
+	r54TranscodeNS atomic.Int64
+	r54FlushNS     atomic.Int64
+)
+
+func r54Measure(slot *atomic.Int64, started time.Time) {
+	slot.Add(int64(time.Since(started)))
+}
+
+func r54Report() {
+	if r54Pages.Load() == 0 {
+		return
+	}
+	fmt.Fprintf(os.Stderr, "R54PROBE pages=%d readall_us=%d spans_us=%d skeleton_us=%d scan_us=%d transcode_us=%d flush_us=%d\n",
+		r54Pages.Load(),
+		r54ReadallNS.Load()/1000,
+		r54SpansNS.Load()/1000,
+		r54SkeletonNS.Load()/1000,
+		r54ScanNS.Load()/1000,
+		r54TranscodeNS.Load()/1000,
+		r54FlushNS.Load()/1000,
+	)
+}
