diff --git a/prototypes/v1/src/worker_rpc/r55_probe.rs b/prototypes/v1/src/worker_rpc/r55_probe.rs
new file mode 100644
index 0000000..0d87698
--- /dev/null
+++ b/prototypes/v1/src/worker_rpc/r55_probe.rs
@@ -0,0 +1,50 @@
+//! Temporary R55 upper-bound probe. Not for merge.
+
+use std::sync::atomic::{AtomicU64, Ordering};
+
+pub(crate) static PRE_NS: AtomicU64 = AtomicU64::new(0);
+pub(crate) static GATE_NS: AtomicU64 = AtomicU64::new(0);
+pub(crate) static STEP_NS: AtomicU64 = AtomicU64::new(0);
+pub(crate) static POST_NS: AtomicU64 = AtomicU64::new(0);
+pub(crate) static ROWS: AtomicU64 = AtomicU64::new(0);
+pub(crate) static PAGES: AtomicU64 = AtomicU64::new(0);
+
+pub(crate) fn add_pre(elapsed: std::time::Duration) {
+    PRE_NS.fetch_add(elapsed.as_nanos() as u64, Ordering::Relaxed);
+}
+
+pub(crate) fn add_gate(elapsed: std::time::Duration) {
+    GATE_NS.fetch_add(elapsed.as_nanos() as u64, Ordering::Relaxed);
+}
+
+pub(crate) fn add_step(elapsed: std::time::Duration) {
+    STEP_NS.fetch_add(elapsed.as_nanos() as u64, Ordering::Relaxed);
+}
+
+pub(crate) fn add_post(elapsed: std::time::Duration) {
+    POST_NS.fetch_add(elapsed.as_nanos() as u64, Ordering::Relaxed);
+}
+
+pub(crate) fn add_page(rows: usize) {
+    PAGES.fetch_add(1, Ordering::Relaxed);
+    ROWS.fetch_add(rows as u64, Ordering::Relaxed);
+}
+
+pub(crate) fn report_and_reset() {
+    let pre = PRE_NS.swap(0, Ordering::Relaxed);
+    let gate = GATE_NS.swap(0, Ordering::Relaxed);
+    let step = STEP_NS.swap(0, Ordering::Relaxed);
+    let post = POST_NS.swap(0, Ordering::Relaxed);
+    let rows = ROWS.swap(0, Ordering::Relaxed);
+    let pages = PAGES.swap(0, Ordering::Relaxed);
+    if pages == 0 {
+        return;
+    }
+    eprintln!(
+        "R55PROBE pages={pages} rows={rows} pre_us={} gate_us={} step_us={} post_us={}",
+        pre / 1000,
+        gate / 1000,
+        step / 1000,
+        post / 1000,
+    );
+}
