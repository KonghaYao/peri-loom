+// R57GATE: probe-only counters, stripped before measurement.
+static R57GATE_FIRST: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+static R57GATE_FETCH: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+fn r57gate(count: &std::sync::atomic::AtomicU64, label: &str) {
+    let value = count.fetch_add(1, std::sync::atomic::Ordering::Relaxed) + 1;
+    eprintln!("R57GATE {label}={value}");
+}
+
 impl Serialize for ReadCursorPage {
     fn serialize<S>(&self, serializer: S) -> Result<S::Ok, S::Error>
     where
         S: Serializer,
     {
+        if self.cols.is_some() {
+            r57gate(&R57GATE_FIRST, "first");
+        } else {
+            r57gate(&R57GATE_FETCH, "fetch");
+        }
         // Same key order as the tree it replaces: `json!` objects are sorted, and
         // keeping the reply byte-compatible makes the two shapes interchangeable
