diff --git a/prototypes/v1/src/worker_rpc/r53_probe.rs b/prototypes/v1/src/worker_rpc/r53_probe.rs
new file mode 100644
index 0000000..7af0399
--- /dev/null
+++ b/prototypes/v1/src/worker_rpc/r53_probe.rs
@@ -0,0 +1,73 @@
+//! Temporary R53 upper-bound probe. Not for merge.
+
+use std::cell::RefCell;
+use std::time::Duration;
+
+#[derive(Default)]
+pub(crate) struct Sample {
+    kind: &'static str,
+    started: Option<std::time::Instant>,
+    native: Duration,
+    tree: Duration,
+    clone: Duration,
+    response_bytes: usize,
+    seq: u64,
+}
+
+thread_local! {
+    static SAMPLE: RefCell<Sample> = RefCell::new(Sample::default());
+}
+
+pub(crate) fn reset() {
+    SAMPLE.with(|sample| {
+        let mut sample = sample.borrow_mut();
+        sample.kind = "";
+        sample.started = Some(std::time::Instant::now());
+        sample.native = Duration::ZERO;
+        sample.tree = Duration::ZERO;
+        sample.clone = Duration::ZERO;
+        sample.response_bytes = 0;
+        sample.seq += 1;
+    });
+}
+
+pub(crate) fn set_kind(kind: &'static str) {
+    SAMPLE.with(|sample| sample.borrow_mut().kind = kind);
+}
+
+pub(crate) fn add_native(elapsed: Duration) {
+    SAMPLE.with(|sample| sample.borrow_mut().native += elapsed);
+}
+
+pub(crate) fn add_tree(elapsed: Duration) {
+    SAMPLE.with(|sample| sample.borrow_mut().tree += elapsed);
+}
+
+pub(crate) fn add_clone(elapsed: Duration) {
+    SAMPLE.with(|sample| sample.borrow_mut().clone += elapsed);
+}
+
+pub(crate) fn record_response_bytes(bytes: usize) {
+    SAMPLE.with(|sample| sample.borrow_mut().response_bytes = bytes);
+}
+
+pub(crate) fn report(serialize: Duration, write: Duration) {
+    SAMPLE.with(|sample| {
+        let sample = sample.borrow();
+        if sample.kind.is_empty() {
+            return;
+        }
+        let _ = format!(
+            "R53PROBE seq={} kind={} total_us={} native_us={} clone_us={} tree_us={} serialize_us={} write_us={} response_bytes={}",
+            sample.seq,
+            sample.kind,
+            sample.started.map(|started| started.elapsed().as_micros()).unwrap_or(0),
+            sample.native.as_micros(),
+            sample.clone.as_micros(),
+            sample.tree.as_micros(),
+            serialize.as_micros(),
+            write.as_micros(),
+            sample.response_bytes,
+        );
+    });
+}
