# ============================================================================
# DB Platform 环境变量样例。复制为 .env 后按需修改。
#
#   cp .env.example .env
#
# 注意：真实的密码 / 密钥不要写进仓库，生产环境请使用 secrets/ 目录挂载文件
# （见 docker-compose.yml 的 secrets 段与 deploy/secrets/README.md）。
# ============================================================================

# ---------------------------------------------------------------- 版本 / 镜像
# 由于国内网络无法直连 Docker Hub，基础镜像请先执行 ./scripts/docker-pull.sh，
# 或把 IMAGE_REGISTRY 指向内网镜像仓库。
IMAGE_REGISTRY=
RUST_IMAGE=rust:1.98-slim-bookworm
RUNTIME_IMAGE=debian:bookworm-slim
POSTGRES_IMAGE=postgres:16-alpine
NGINX_IMAGE=nginx:1.27-alpine
NODE_IMAGE=node:22-alpine
# S3 兼容对象存储（Snapshot / Backup）。默认 RustFS（Apache-2.0）；
# MinIO 社区版已下架官方镜像并转向 AGPLv3，不再作为默认依赖。
OBJECT_STORE_IMAGE=rustfs/rustfs:1.0.0

# ---------------------------------------------------------------- 端口
# 默认只发布 web。开发时可打开 db-server 直连端口（SDK 调试用）。
WEB_PORT=8080
DB_SERVER_DEV_PORT=18080

# ---------------------------------------------------------------- 日志
RUST_LOG=info,db_server=debug,db_worker=debug,wal_service=debug

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_DB=dbplatform
POSTGRES_USER=dbplatform
POSTGRES_PASSWORD=change-me-in-production
# db-server 连接串（容器内网地址）
DATABASE_URL=postgres://dbplatform:change-me-in-production@postgres:5432/dbplatform
# 连接池
CATALOG_MAX_CONNECTIONS=32

# ---------------------------------------------------------------- db-server
SERVER_GRPC_LISTEN=0.0.0.0:8081
SERVER_HTTP_LISTEN=0.0.0.0:8080
# Route Cache 的兜底 reconcile 周期（Control Plane 不可用时不得主动清空已缓存 Route）
ROUTE_RECONCILE_INTERVAL_MS=5000
ROUTE_CACHE_MAX_ENTRIES=1000000
# Cold Start 透明 Wake：请求等待 DB READY 的最长时间
WAKEUP_TIMEOUT_MS=3000
WAKEUP_POLL_INTERVAL_MS=20
# Session / Transaction 默认值（架构 §15.3，冻结为 60s / 30s）
SESSION_IDLE_TIMEOUT_MS=60000
TRANSACTION_MAX_LIFETIME_MS=30000
# 结果集内联返回上限，超过则 NDJSON streaming
INLINE_RESULT_LIMIT_BYTES=262144

# JWT / OIDC（开发用 HS256；生产接 OIDC JWKS）
JWT_SECRET=dev-only-change-me
JWT_ISSUER=db-platform
JWT_TTL_SECONDS=3600
# 首次启动自动创建的管理员（仅当 users 表为空时生效）
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=admin12345

# ---------------------------------------------------------------- Workers
WORKER_ID=worker-1
WORKER_REGION=default
WORKER_ZONE=default
# Worker 控制面监听（gRPC，供 db-server 连接）
WORKER_CONTROL_LISTEN=0.0.0.0:9100
# Worker Data Dispatcher 监听（gRPC/HTTP2 streaming）
WORKER_DATA_LISTEN=0.0.0.0:9101
# Worker 侧 db-server 控制面地址（用于 Heartbeat 上报）
SERVER_CONTROL_ENDPOINT=http://db-server:8081
# 本地 NVMe 工作集目录与 UDS 运行目录
WORKER_DATA_DIR=/var/lib/db-platform
WORKER_RUN_DIR=/run/db-platform
# 资源预算（milli-core / MiB），须与本机实际资源一致，否则 Scheduler Packing 失真
WORKER_CPU_MILLI=32000
WORKER_MEMORY_MIB=131072
WORKER_DISK_MIB=512000
WORKER_PROCESS_SLOTS=2048
WORKER_IOPS=200000
# DB 数量只作 hard safety limit（架构 §9）
WORKER_MAX_DB_PROCESS=2000
# Heartbeat 周期（架构 §16：1s/次，连续 3 次 miss 判 Suspect）
HEARTBEAT_INTERVAL_MS=1000
# cgroup v2 根路径（容器内通常已挂到 /sys/fs/cgroup）
WORKER_CGROUP_ROOT=/sys/fs/cgroup

# ---------------------------------------------------------------- Remote WAL
WAL_NODE_ID=1
WAL_SHARD_ID=shard-0
WAL_LISTEN=0.0.0.0:9200
WAL_PEER_LISTEN=0.0.0.0:9201
# 3 副本 Raft 成员（node_id@endpoint）
WAL_CLUSTER=1@wal-1:9201,2@wal-2:9201,3@wal-3:9201
WAL_DATA_DIR=/var/lib/db-platform/wal
# 成功 Append 必须 quorum durable；此值控制 Append 等待超时
WAL_APPEND_TIMEOUT_MS=5000
# LSN 之前的 WAL 在快照覆盖后可截断
WAL_TRIM_INTERVAL_MS=60000

# ---------------------------------------------------------------- 存储 / 快照
S3_ENDPOINT=http://object-store:8333
S3_REGION=us-east-1
S3_BUCKET=db-platform-snapshots
S3_ACCESS_KEY_ID=dbplatform
S3_SECRET_ACCESS_KEY=change-me-in-production
S3_FORCE_PATH_STYLE=true
# 快照与备份策略
SNAPSHOT_INTERVAL_MS=300000
BACKUP_RETENTION_DAYS=7

# ---------------------------------------------------------------- 观测
METRICS_LISTEN=0.0.0.0:9090
# 留空则关闭 OTLP 导出（compose 的 observability profile 会启动 collector）
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAMESPACE=db-platform
SLOW_QUERY_THRESHOLD_MS=1000
GRAFANA_ADMIN_PASSWORD=change-me-in-production
